BOT_TOKEN=your_discord_bot_token
STEAM_API_KEY=your_steam_api_key
FACEIT_API_KEY=your_faceit_api_key
FFMPEG_PATH=ffmpeg

# Optional Netscape cookies file for YouTube authentication
YOUTUBE_COOKIES_FILE=

# Set to the persistent storage directory provided by your host
BOT_DATA_DIR=/app/shared/hunter-bot
# Enable after migrating the existing database:
BOT_REQUIRE_EXISTING_DB=1
